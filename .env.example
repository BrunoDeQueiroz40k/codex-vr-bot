# Copie este arquivo para ".env" e preencha com seus valores reais.
# O token do Discord você pega em:
#   https://discord.com/developers/applications -> sua aplicação -> Bot -> Reset Token
DISCORD_TOKEN=cole_seu_token_aqui

# (Opcional) Publicação no Vercel Blob, para o site na Vercel ler sempre a
# versão mais recente do avatars.json. Sem isso, o bot só grava localmente.
# Pegue em: Vercel -> Storage -> crie um Blob Store -> aba .env / "Connect"
# (variável BLOB_READ_WRITE_TOKEN, formato vercel_blob_rw_...).
BLOB_READ_WRITE_TOKEN=
